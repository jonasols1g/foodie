# Firebase (Firestore Database + Anonymous Auth). Skaff verdiene fra
# Firebase Console -> Project settings -> General -> Your apps (Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mapbox: kart (GL JS) + Search Box API (restaurantsøk/autocomplete). Bruk en
# PUBLIC token (pk.*), begrens den til URL-referrer for produksjonsdomenet
# (https://<bruker>.github.io/*) + localhost for lokal utvikling.
# https://console.mapbox.com/account/access-tokens/
VITE_MAPBOX_TOKEN=
